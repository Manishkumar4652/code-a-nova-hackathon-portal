PORT=5000
MONGO_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Mailing configuration (Gmail SMTP — use a Google App Password, not your login password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_project_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Optional: mailbox shown on the Contact page and receiving contact-form messages
# (defaults to EMAIL_USER)
CONTACT_EMAIL=
